# Copy to .env on the target host, chmod 600. Never commit the real file.

# Fine-grained GitHub PAT.
# Required scopes: Metadata (read), Administration (read)
# Repository access: All repositories
GITHUB_TOKEN=

# GitHub account or org that owns the repos to track
GITHUB_OWNER=

# Public hostname shown in the dashboard footer. Cosmetic only.
CLIO_PUBLIC_HOST=localhost:8080

# --- Docker Compose only -------------------------------------------------
# Ignored by the bare-metal install, which uses peer auth over a unix socket.

# Password for the bundled Postgres container. It is never exposed outside
# the compose network, but change it anyway if the host is shared.
POSTGRES_PASSWORD=clio-local-only

# Host port for the dashboard.
CLIO_PORT=8080

# Seconds between collector runs. The systemd build uses a timer instead.
CLIO_INTERVAL_SECONDS=10800
